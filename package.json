{
  "name": "laitse-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.0"
  },
  "workspaces": [
    "poc"
  ],
  "scripts": {
    "typecheck": "npm run --workspace=poc typecheck",
    "build": "npm run --workspace=poc build",
    "start": "npm run --workspace=poc start",
    "test": "npm run --workspace=poc test",
    "test:integration": "npm run --workspace=poc test:integration",
    "test:persistence": "npm run --workspace=poc test:persistence",
    "test:e2e": "npm run --workspace=poc test:e2e",
    "tls:dev": "npm run --workspace=poc tls:dev",
    "licenses": "npm run --workspace=poc licenses"
  }
}
