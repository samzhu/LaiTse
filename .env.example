# Local development only. Replace both sample passwords before starting Docker.
POSTGRES_DB=laitse
POSTGRES_USER=laitse_local
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgresql://laitse_local:local-only-change-me@127.0.0.1:55432/laitse

# Local app settings. Choose managed-host mode before the first database bootstrap.
# Replace the sample host token; its enabled/disabled mode is persisted, its value is not.
# HOST stays on loopback by default.
HOST=127.0.0.1
PORT=4173
MEETING_ROOM_PASSWORD=
HOST_CONTROL_TOKEN=local-only-host-control-token-change-me
